{
  "name": "gamehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests scripts *.mjs --max-warnings=0",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "seed:prompts": "node scripts/seed-prompts.mjs",
    "seed:online": "tsx scripts/seed-online-ports.ts",
    "test:extract": "node scripts/test-extract.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.0",
    "planck": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "playwright-core": "1.63.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
